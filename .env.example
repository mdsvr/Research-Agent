# Copy this file to `.env` and fill in the keys you have. `.env` is gitignored.
# Loaded automatically on `import veritas`; exported shell variables take precedence.
#
# Providers are tried in the order of `llm.providers` in config.yaml. A provider with
# no key set is skipped silently, so you only need to fill in what you use.

# Groq (default; fast, free tier, OpenAI-compatible JSON mode) — https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free model slugs like openai/gpt-oss-20b:free may be unavailable) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: local Ollama server on :11434 (no key needed; skipped if not running)
